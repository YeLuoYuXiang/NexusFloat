<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        列出已安装应用，供「仅在选定应用显示」的应用选择页使用。
        Android 11 起应用默认只能看到自己，没有该权限时列表几乎是空的。
        这是安装时授予的 normal 权限，不弹运行时弹窗；仅本地展示，不联网。
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!--
        开机自启（v1.8.0）：重启后不等用户打开 App，模块进程即被拉起并开始
        GPU 采集，SystemUI 的监视条立即可用。normal 权限，安装时授予。
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        统计采样要跨息屏、跨应用一直跑，只能靠前台服务。specialUse 类型没有时长上限；
        dataSync 从 Android 15 起一天只给 6 小时，对「一直在记」的场景等于没有。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 13+ 前台服务的通知要这个权限；不给也只是通知不显示，服务照跑 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        「使用情况访问」。统计页靠它拿到精确的亮屏时长和逐应用前台时长。
        这是设置里的开关，不是运行时弹窗；没授权时自动退回采样积分的估算值。
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
        帧记录悬浮球：用户点开始后要切到游戏里去，控制球必须能盖在别的应用上面。
        有 root 时会先试 appops 静默授权，不行再引导到设置页。
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NexusFloat">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            充电与使用统计的采样服务。

            foregroundServiceType 必须写 specialUse，并配一条 subtype 说明用途：
            Android 14 起前台服务必须声明类型，specialUse 还要求给出具体描述，
            没有这条属性 startForeground 会直接抛异常。
        -->
        <service
            android:name=".stats.StatsService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="battery_charge_and_usage_statistics" />
        </service>

        <!--
            帧率记录的前台服务。用户在记录页点开始后切到游戏里，悬浮球要一直显示、
            采样要一直跑，所以同样走 specialUse。长按悬浮球收掉时服务退场，
            记录中的那一条会先保存再退。
        -->
        <service
            android:name=".frame.FrameRecordService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="frame_rate_recording_overlay" />
        </service>

        <provider
            android:name=".service.EarlyInitProvider"
            android:authorities="com.jj.nexusfloat.earlyinit"
            android:directBootAware="true"
            android:exported="true" />

        <!--
            开机自启（v1.8.0）。registered-only 的 receiver 拿不到 BOOT_COMPLETED
            （进程死了没人收），必须 manifest 注册。exported=false 挡第三方伪造
            广播——系统广播照常送达。
            LOCKED_BOOT_COMPLETED 那条要求 receiver directBootAware，
            这样 Direct Boot 阶段（未解锁）也能把进程先拉起来。
        -->
        <receiver
            android:name=".service.BootReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!--
            被 SystemUI 唤醒（v1.8.11）。

            必须 exported=true：SystemUI 是另一个应用，要能发广播到这个接收者。
            action 带包名前缀，且下面的 intent-filter 只认这一个 action，
            别的应用发不出有意义的指令。

            ColorOS 全部清除后台会把本应用置为 stopped 状态，这个状态下只有带
            FLAG_INCLUDE_STOPPED_PACKAGES 的广播能送达——SystemUI 侧发广播时
            会带上它（见 CollectorSignal.wakeModule）。
        -->
        <receiver
            android:name=".service.WakeReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.jj.nexusfloat.action.WAKE_COLLECTOR" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
